# ─────────────────────────────────────────────────────────────────────────────
#  Greg — configuration
#  Copy this file to ".env" (in the same folder) and fill in the values.
#  Never commit your real .env — it holds secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram (REQUIRED) ──────────────────────────────────────────────────────
# 1. Open Telegram, chat with @BotFather, send /newbot, follow the prompts.
# 2. BotFather gives you a token like 123456789:AAE...  — paste it here.
TELEGRAM_BOT_TOKEN=

# Your own Telegram numeric user id, so Greg ONLY obeys you and ignores strangers.
# Get it by messaging @userinfobot on Telegram (it replies with your id).
# You can list several ids separated by commas (e.g. your phone + your tablet).
TELEGRAM_ALLOWED_USER_IDS=

# ── Claude, Greg's brain (REQUIRED) ──────────────────────────────────────────
# Create a key at https://console.anthropic.com/  → API Keys.
# This is what turns "open youtube" / "turn the volume down" into real actions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── Voice notes (OPTIONAL) ───────────────────────────────────────────────────
# Add an OpenAI key to let Greg understand voice messages (Whisper transcription).
# Leave blank and Greg still works perfectly with typed messages.
OPENAI_API_KEY=

# ── Safety switch (OPTIONAL) ─────────────────────────────────────────────────
# Greg can run raw commands on your laptop ("full access"). Set to "false" to
# disable the run_command tool if you ever want Greg locked down to safe actions.
GREG_ALLOW_SHELL=true

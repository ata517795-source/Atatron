# ── Infinite Story Realms ────────────────────────────────────────────────
# Copy this file to `.env` and fill in your values.
# NEVER commit `.env` — it is gitignored.

# Anthropic API key from https://console.anthropic.com
# Used ONLY by the serverless function (api/story.ts) — never shipped to the browser.
# If unset, the app runs in a clearly-labeled offline mock mode.
ANTHROPIC_API_KEY=

# Optional: override the DM model without editing code.
# Default: claude-haiku-4-5 (fast/cheap). Try claude-sonnet-5 for richer prose.
# DM_MODEL=claude-sonnet-5

# ── Optional image layer (off by default) ────────────────────────────────
# Set to 1 to have the client request scene art from /api/image.
# The /api/image proxy is a stub until you pick an image provider and wire
# its key below — the app runs fully without images.
# VITE_IMAGE_ENABLED=1
# IMAGE_API_KEY=

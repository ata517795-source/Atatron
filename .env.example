# ── Google Maps (Street View mode) ──────────────────────────────────────────
# Create a key at https://console.cloud.google.com/ with billing enabled and
# these APIs turned on:
#   • Maps JavaScript API   (Street View panoramas + mini-map)
#   • Street View Static API (photo capture inside Street View)
# The app runs fully without this key — Street View mode falls back to a
# photo-based exploration of real Wikimedia landmark imagery.
VITE_GOOGLE_MAPS_API_KEY=

# ── Supabase (OPTIONAL — shared Explorers list + leaderboard) ───────────────
# Leave blank to run fully local (nickname/avatar/album stored in the browser).
# See README "Supabase setup" for the one-table schema.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

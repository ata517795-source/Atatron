{
  "name": "busfactor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Finds the knowledge that dies when an engineer quits — then extracts it.",
  "scripts": {
    "start": "npm run build:web && tsx server/index.ts",
    "serve": "tsx server/index.ts",
    "dev:server": "tsx watch server/index.ts",
